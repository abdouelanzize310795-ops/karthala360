# Copier en .env puis adapter
PORT=3000
# Compte admin créé au tout premier démarrage (base vide)
ADMIN_EMAIL=admin@karthala360.km
ADMIN_PASSWORD=changez-moi-svp
# Contact (modifiable ensuite dans le back office)
WHATSAPP_NUMBER=2693565803
CONTACT_EMAIL=contact@discovermores.com
# Active l'IA de K269 (laisser vide sans clé)
ANTHROPIC_API_KEY=
K269_MODEL=claude-haiku-5-5

# Consultation de la base (http://localhost:8080, lecture seule)
